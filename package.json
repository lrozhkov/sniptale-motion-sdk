{
  "name": "@sniptale/motion-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic authoring, validation, preview, and export tooling for Sniptale motion effects.",
  "license": "MIT",
  "author": "Lev Rozhkov",
  "repository": "https://github.com/lrozhkov/sniptale-motion-sdk.git",
  "homepage": "https://github.com/lrozhkov/sniptale-motion-sdk#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tooling/vite/dev.mjs",
    "effect:new": "tsx tooling/effect-v1/new.ts",
    "effect:schema": "tsx tooling/effect-v1/schema.ts --output schemas/sniptale-effect-v1.schema.json",
    "effect:schema:check": "tsx tooling/effect-v1/schema.ts --output schemas/sniptale-effect-v1.schema.json --check",
    "effect:validate": "tsx tooling/effect-v1/validate.ts",
    "effect:prove": "npm run build && npm run effect:prove:runtime --",
    "effect:prove:runtime": "tsx tooling/effect-v1/prove.ts",
    "effect:corpus": "tsx tooling/effect-v1/corpus/generate.ts",
    "effect:corpus:check": "tsx tooling/effect-v1/corpus/verify.ts",
    "release:legal": "node tooling/release/dependency-legal/generate-production-legal.mjs",
    "release:legal:check": "node tooling/release/dependency-legal/validate-production-legal.mjs",
    "build": "npm run release:legal && node tooling/build/run.mjs",
    "build:npm": "node tooling/release/npm/build.mjs",
    "build:local": "node tooling/build/run.mjs --include-local-demo-pack",
    "serve": "node tooling/http/serve.mjs",
    "qa:preflight": "node tooling/qa/wrappers/preflight.mjs",
    "qa:checkpoint": "node tooling/qa/wrappers/checkpoint.mjs",
    "qa:build": "node tooling/qa/wrappers/build.mjs",
    "qa:coverage": "node tooling/qa/wrappers/coverage.mjs",
    "qa:closeout": "node tooling/qa/wrappers/closeout.mjs",
    "qa:licenses": "node tooling/release/dependency-legal/audit-full-lock.mjs",
    "qa:security": "node tooling/qa/wrappers/security.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --config tooling/configs/qa/vitest.ts",
    "test:coverage": "vitest run --coverage --config tooling/configs/qa/vitest.ts",
    "test:npm": "node tooling/release/npm/accept.mjs",
    "test:smoke": "node tooling/test/smoke/run.mjs",
    "qa": "npm run qa:checkpoint && npm run qa:build",
    "qa:dependencies": "node tooling/qa/security/dependency-age.mjs",
    "format": "node tooling/qa/formatting/run.mjs",
    "format:write": "node tooling/qa/formatting/run.mjs --write"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.184.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "skills": "1.7.4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "lucide": "1.61.0",
    "mediabunny": "1.62.1",
    "playwright-core": "1.64.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.184.0"
  },
  "packageManager": "npm@12.2.0"
}
