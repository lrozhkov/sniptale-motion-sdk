{
  "name": "@sniptale/motion-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic authoring, validation, preview, and export tooling for Sniptale motion effects.",
  "license": "MIT",
  "author": "Lev Rozhkov",
  "repository": "https://github.com/lrozhkov/sniptale-motion-sdk.git",
  "homepage": "https://github.com/lrozhkov/sniptale-motion-sdk#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --require ./tooling/process/environment.cjs --import tsx tooling/vite/dev.ts",
    "effect:new": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/new.ts",
    "effect:schema": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/schema.ts --output schemas/sniptale-effect-v1.schema.json",
    "effect:schema:check": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/schema.ts --output schemas/sniptale-effect-v1.schema.json --check",
    "effect:validate": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/validate.ts",
    "effect:prove": "npm run build && npm run effect:prove:runtime --",
    "effect:prove:runtime": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/prove.ts",
    "effect:corpus": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/corpus/generate.ts",
    "effect:corpus:check": "node --require ./tooling/process/environment.cjs --import tsx tooling/effect-v1/corpus/verify.ts",
    "release:legal": "node --require ./tooling/process/environment.cjs --import tsx tooling/release/dependency-legal/generate-production-legal.ts",
    "release:legal:check": "node --require ./tooling/process/environment.cjs --import tsx tooling/release/dependency-legal/validate-production-legal.ts",
    "build": "npm run release:legal && node --require ./tooling/process/environment.cjs --import tsx tooling/build/run.ts",
    "build:npm": "node --require ./tooling/process/environment.cjs --import tsx tooling/release/npm/build.ts",
    "build:local": "node --require ./tooling/process/environment.cjs --import tsx tooling/build/run.ts --include-local-demo-pack",
    "serve": "node --require ./tooling/process/environment.cjs --import tsx tooling/http/serve.ts",
    "qa:preflight": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/preflight.ts",
    "qa:checkpoint": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/checkpoint.ts",
    "qa:build": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/build.ts",
    "qa:coverage": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/coverage.ts",
    "qa:closeout": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/closeout.ts",
    "qa:licenses": "node --require ./tooling/process/environment.cjs --import tsx tooling/release/dependency-legal/audit-full-lock.ts",
    "qa:security": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/wrappers/security.ts",
    "typecheck": "npm run typecheck:workspace && npm run typecheck:product && npm run typecheck:tooling && npm run typecheck:sdk",
    "test": "node --require ./tooling/process/environment.cjs node_modules/vitest/vitest.mjs run --config tooling/configs/qa/vitest.ts",
    "test:coverage": "node --require ./tooling/process/environment.cjs node_modules/vitest/vitest.mjs run --coverage --config tooling/configs/qa/vitest.ts",
    "test:npm": "node --require ./tooling/process/environment.cjs --import tsx tooling/release/npm/accept.ts",
    "test:smoke": "node --require ./tooling/process/environment.cjs --import tsx tooling/test/smoke/run.ts",
    "qa": "npm run qa:checkpoint && npm run qa:coverage && npm run qa:build",
    "qa:dependencies": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/security/dependency-age.ts",
    "format": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/formatting/run.ts",
    "format:write": "node --require ./tooling/process/environment.cjs --import tsx tooling/qa/formatting/run.ts --write",
    "typecheck:workspace": "node --require ./tooling/process/environment.cjs node_modules/@typescript/native/bin/tsc --noEmit -p tooling/configs/typescript/workspace.json",
    "typecheck:product": "node --require ./tooling/process/environment.cjs node_modules/@typescript/native/bin/tsc --noEmit -p tooling/configs/typescript/product.json",
    "lint:product": "node --require ./tooling/process/environment.cjs node_modules/oxlint/bin/oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --no-ignore -c tooling/configs/qa/oxlint.json src",
    "typecheck:sdk": "node --require ./tooling/process/environment.cjs node_modules/@typescript/native/bin/tsc --noEmit -p tooling/configs/typescript/sdk.json",
    "typecheck:tooling": "node --require ./tooling/process/environment.cjs node_modules/@typescript/native/bin/tsc --noEmit -p tooling/configs/typescript/tooling.json",
    "lint:tooling": "node --require ./tooling/process/environment.cjs node_modules/oxlint/bin/oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --no-ignore -c tooling/configs/qa/oxlint.json tooling tests/smoke tests/smoke.spec.ts",
    "lint:tests": "node --require ./tooling/process/environment.cjs node_modules/oxlint/bin/oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --no-ignore -c tooling/configs/qa/oxlint.json tests"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@types/three": "0.184.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "skills": "1.7.4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "lucide": "1.61.0",
    "mediabunny": "1.62.1",
    "playwright-core": "1.64.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "7.8.5",
    "three": "0.184.0"
  },
  "packageManager": "npm@12.2.0"
}
